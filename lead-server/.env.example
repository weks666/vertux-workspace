# Example only. Values are supplied privately on the server, never in frontend.
LEAD_ENABLED=false
LEAD_SUPABASE_URL=https://your-existing-workspace-database.example.com
LEAD_SUPABASE_ANON_KEY=
LEAD_SUPABASE_SERVICE_KEY=
LEAD_ORGANIZATION_ID=
LEAD_PRODUCT_ID=
LEAD_USAGE_SALT=
LEAD_PORT=47921
LEAD_POLL_MS=5000
LEAD_REQUESTS_PER_MINUTE=60
LEAD_ORIGINS=https://weks666.github.io,https://workspace.vertux.online

# Optional existing OpenRouter provider. AI remains off without positive budgets.
LEAD_OPENROUTER_KEY=
LEAD_ALLOWED_MODELS=openai/gpt-4.1-mini
LEAD_PROVIDER_NAME=OpenAI
LEAD_PROVIDER_SLUG=openai
LEAD_MAX_KEY_USD=0
LEAD_MAX_DAILY_USD=0
LEAD_MAX_COMPANY_USD=0

# Personal ChatGPT connection; tokens live only in the protected runtime directory.
# Owner ID must already be an active Workspace owner. Login does not enable AI.
LEAD_CHATGPT_OWNER_ID=
LEAD_CHATGPT_DIRECTORY=/state/chatgpt
LEAD_CHATGPT_PORT=47922
LEAD_MAX_DAILY_PLAN_REQUESTS=10

# Optional network-isolated JavaScript renderer and single-page technical probe.
LEAD_BROWSER_IMAGE=
LEAD_BROWSER_SECCOMP_PROFILE=
LEAD_PSI_ENABLED=0
LEAD_PAGESPEED_KEY=
