    "Wrap List": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "PG SetRole": { "main": [[{ "node": "Wrap Set", "type": "main", "index": 0 }]] },
    "Wrap Set": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
